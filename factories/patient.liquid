{
  "resourceType" : "Patient",  
  "id" : "{{ row.counter }}",
  "meta" : {
    "lastUpdated" : "{{ Globals.dateTime }}"
  },
  {% assign genderfhir = row.GenderIdentiteit %} 
  "text" : {
    "status" : "generated",
    "div" : "<div xmlns=\"http://www.w3.org/1999/xhtml\">{{ row.Achternaam }}, {{ row.Voornaam }}. MRN: {{ row.Identificatienummer}}, Gender: {{ genderfhir }} - Gender V2: todo  </div>",
  }
  "identifier:" :{ 
    "system" : "http://fhir.nl/fhir/NamingSystem/bsn",
    "value" : "{{ row.Identificatienummer }}",
  },
  "active"  : "true",
  "name" : [{
    "use" : "official",
    "text:" : "{{ row.Persoonsnaam }}",
    "family" : "{{ row.Achternaam }}",
    "given" : "{{ row.Voornaam }}"
  }],
  "gender" : "{{ row.GenderIdentiteit }}",
  "address" : [{
    "use" : "official",
    "country" : "{{ countries.cell(Globals.random(245)+1, 'name') }}"
  }],
  "birthDate" : "{{ row.Geboortedatum }}"
}